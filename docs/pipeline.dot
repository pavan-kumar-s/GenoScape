digraph GenoScape {
    rankdir=LR;
    bgcolor="white";
    nodesep=0.35;
    ranksep=0.55;
    node [shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5",
          fontname="Helvetica", fontsize=16, margin="0.18,0.12"];
    edge [fontname="Helvetica", fontsize=13, color="#666666"];

    input   [label="Organism\nname", fillcolor="#f5f5f5", color="#888888"];
    ncbi    [label="NCBI\ntaxon ID"];
    bacdive [label="BacDive\nstrain"];
    carbon  [label="Carbon-source\ntests"];
    save    [label="Save\nJSON file", fillcolor="#e3f6e8", color="#3a8a53"];

    input -> ncbi -> bacdive -> carbon;

    subgraph cluster_ref {
        label = "once per reference";
        style = "dashed";
        fontsize = 13;
        fontname = "Helvetica";
        color = "#999999";
        margin = 14;

        pmc      [label="PubMed\nCentral"];
        fallback [label="Crossref /\nUnpaywall"];
        extract  [label="Extract\nmedia (LLM)", fillcolor="#f0e8fa", color="#7a4fa5"];

        pmc -> extract [label="found"];
        pmc -> fallback [label="not found"];
        fallback -> extract;
    }

    carbon -> pmc;
    extract -> save;
}
